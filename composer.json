{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "akaunting/laravel-money": "^6.0",
        "awobaz/compoships": "^2.2",
        "doctrine/dbal": "^4.0",
        "google/cloud-translate": "^1.19",
        "greenlion/php-sql-parser": "^4.7",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.46",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/flysystem": "^3.18",
        "league/flysystem-ftp": "^3.16",
        "opcodesio/log-viewer": "^3.24",
        "php-open-source-saver/jwt-auth": "^2.9",
        "predis/predis": "^2.2",
        "spatie/laravel-sluggable": "^4.0",
        "wildbit/postmark-php": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/sail": "^1.58",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Functions/dataChecker.php",
            "app/Helpers/Functions/randomGenerator.php",
            "app/Helpers/Functions/postmarkTokenEncryptionDecryption.php",
            "app/Helpers/Functions/translator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
